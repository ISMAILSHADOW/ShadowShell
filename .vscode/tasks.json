{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Test via Script",
            "type": "shell",
            "command": "${workspaceFolder}/build.sh",
            "args": [
                "test"
            ],
            "group": "build"
        },
        {
            "label": "Build Debug via Script",
            "type": "shell",
            "command": "${workspaceFolder}/build.sh",
            "args": [
                "-d"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}